# Copy this file to .env and fill in. Nothing is ever sent to a bank.
# Gmail: turn on 2-step verification, then Google Account > Security > App passwords > create one for "Mail".
VASOOL_SMTP_USER=yourname@gmail.com
VASOOL_SMTP_PASS=xxxx xxxx xxxx xxxx
# SAFETY NET: when set, every mail goes to this address no matter who the recipient is.
VASOOL_DEMO_TO=teammate@gmail.com
# Optional: so the Approve button in the mail opens the app from a phone on the same hotspot.
# Use the IPv4 address run.bat prints, e.g. http://192.168.43.12:8000
VASOOL_PUBLIC_URL=
# REAL TAMIL CALL (optional). Twilio console > Account Info: Account SID, Auth Token, and your Twilio phone number.
# On a trial account only "Verified caller IDs" can be dialled — verify the phone you will show the judges.
VASOOL_TWILIO_SID=
VASOOL_TWILIO_TOKEN=
VASOOL_TWILIO_FROM=+1xxxxxxxxxx
# SAFETY NET: when set, every call goes to this number no matter whose phone is on the form. +91 form, no spaces.
VASOOL_DEMO_PHONE=+91xxxxxxxxxx
# Optional: your own TwiML Bin (Console > TwiML Bins) containing <Say voice="{{voice}}" language="{{language}}">{{text}}</Say>
# VASOOL_TWILIO_TWIML_URL=https://handler.twilio.com/twiml/EHxxxxxxxx
# RED ALERTS on Telegram (optional). @BotFather → token; message your bot once, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  ("chat":{"id":...})
VASOOL_TELEGRAM_TOKEN=
VASOOL_TELEGRAM_CHAT=
# Alert window in days before the limitation clock (default 60); limitation clock length (default 365)
# VASOOL_ALERT_DAYS=60
# Encryption key for the database (optional). If absent a key file data/.vasool.key is created once. Back it up!
# VASOOL_SECRET_KEY=<44-char base64 of 32 random bytes>
# VASOOL_AUTH=off   ← single-user mode without login (dev/demo only; default on)
# Optional: the assistant may rephrase answers with an LLM (facts still come from the rulebook)
# VASOOL_LLM=on
# ANTHROPIC_API_KEY=
